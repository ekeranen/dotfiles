[user]
	name = Eric Keranen
	email = eric@erickeranen.com
[alias]
    hist = log --graph --oneline --decorate --all
[core]
    editor = vim
[diff]
	tool = bc
[difftool]
	prompt = false
[difftool "bc"]
	trustExitCode = true
[merge]
	tool = bc
[mergetool]
	prompt = false
	keepBackup = false
[mergetool "bc"]
	trustExitCode = true
